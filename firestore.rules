rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Nessuna regola qui sotto usa mai `allow read, write: if true`.
    // Tutto ciò che non è esplicitamente aperto è negato di default.

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // users/{uid} — profilo pubblico (letto da leaderboard/lega/profilo).
    match /users/{userId} {
      allow read: if isSignedIn();

      // Creazione consentita solo dal proprietario, e solo con contatori
      // a zero: un utente non può auto-assegnarsi punti alla registrazione.
      allow create: if isOwner(userId)
        && request.resource.data.totalPoints == 0
        && request.resource.data.predictionsCount == 0
        && request.resource.data.correctPredictions == 0
        && request.resource.data.exactPredictions == 0
        && request.resource.data.successRate == 0
        && request.resource.data.leagueCount == 0
        && request.resource.data.role == 'user';

      // Baseline sicura per documenti creati prima dell'introduzione di
      // leagueCount (il campo può mancare del tutto, non solo essere 0).
      function currentLeagueCount() {
        return ('leagueCount' in resource.data) ? resource.data.leagueCount : 0;
      }

      // Due soli casi ammessi in update:
      // 1) l'utente modifica il proprio profilo "innocuo" (punti, ruolo,
      //    email, referral restano di competenza server-side / Cloud
      //    Function con Admin SDK, che bypassa queste regole);
      // 2) le transazioni di creazione/adesione a una lega incrementano
      //    leagueCount di esattamente 1 e nient'altro.
      allow update: if isOwner(userId) && (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['firstName', 'lastName', 'photoUrl', 'updatedAt'])
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leagueCount', 'updatedAt'])
          && request.resource.data.leagueCount == currentLeagueCount() + 1)
      );

      allow delete: if false;
    }

    // competitions/{competitionId} (+ teams/matchdays), matches/{matchId},
    // standings/{competitionId} — dati calcistici reali sincronizzati da
    // api-football tramite Cloud Function schedulata (Admin SDK, che
    // ignora queste regole). Il client li legge soltanto: non li scrive
    // mai, né direttamente né tramite una Cloud Function invocabile senza
    // il controllo admin (vedi functions/src/index.ts, syncSerieANow).
    match /competitions/{competitionId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /teams/{teamId} {
        allow read: if isSignedIn();
        allow write: if false;
      }

      match /matchdays/{matchdayId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /standings/{competitionId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // predictions/{userId}_{matchId} — un documento per coppia utente/partita,
    // parte della "schedina" dell'utente per una giornata. Un solo mercato
    // per pronostico (result1x2 | goalNoGoal | overUnder25 | exactScore),
    // coerente con la UI che fa scegliere un tipo di pronostico a partita.
    //
    // Il pronostico richiede che l'utente faccia parte di almeno una lega
    // (regola di prodotto: "niente schedina senza lega"), verificato qui
    // leggendo `users/{uid}.leagueCount`, che è scrivibile SOLO dalle
    // transazioni di creazione/adesione lega (vedi regola `users` sopra) —
    // quindi non è un valore che il client possa falsificare a piacere.
    //
    // Blocco al kickoff enforcement reale: legge `matches/{matchId}.
    // predictionLocked`, campo scritto solo dalla Cloud Function di sync
    // (Admin SDK), quindi non falsificabile dal client. Se la partita non
    // è (ancora) sincronizzata, il get() fallisce e la regola nega per
    // default (fail-closed) — coerente con "niente di aperto per errore".
    match /predictions/{predictionId} {
      function hasLeague() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.leagueCount > 0;
      }

      function matchIsOpen(matchId) {
        return get(/databases/$(database)/documents/matches/$(matchId)).data.predictionLocked == false;
      }

      function isValidPredictionWrite() {
        let data = request.resource.data;
        return data.userId == request.auth.uid
          && predictionId == request.auth.uid + '_' + data.matchId
          && data.market in ['result1x2', 'goalNoGoal', 'overUnder25', 'exactScore']
          && (!('result1x2Value' in data) || data.result1x2Value == null || data.result1x2Value in ['1', 'X', '2'])
          && (!('goalNoGoalValue' in data) || data.goalNoGoalValue == null || data.goalNoGoalValue is bool)
          && (!('overUnder25Value' in data) || data.overUnder25Value == null || data.overUnder25Value is bool)
          && (!('exactHomeScore' in data) || data.exactHomeScore == null ||
              (data.exactHomeScore is int && data.exactHomeScore >= 0 && data.exactHomeScore <= 20))
          && (!('exactAwayScore' in data) || data.exactAwayScore == null ||
              (data.exactAwayScore is int && data.exactAwayScore >= 0 && data.exactAwayScore <= 20));
      }

      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && hasLeague() && matchIsOpen(request.resource.data.matchId) && isValidPredictionWrite();
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.matchId == resource.data.matchId
        && hasLeague()
        && matchIsOpen(request.resource.data.matchId)
        && isValidPredictionWrite();
      allow delete: if false;
    }

    // leagues/{leagueId} — lega privata. "Privata" nel senso che non è
    // elencata pubblicamente: chi conosce l'invite code può leggerla e
    // unirsi. Il documento non contiene nulla di sensibile.
    match /leagues/{leagueId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberCount == 1;

      // Due soli casi ammessi in update:
      // 1) il proprietario modifica i metadati (non tocca campi immutabili);
      // 2) chiunque si unisca incrementa memberCount di esattamente 1 e
      //    nient'altro (è quanto fa la transazione di adesione).
      allow update: if isSignedIn() && (
        (resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.memberCount == resource.data.memberCount)
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
          && request.resource.data.memberCount == resource.data.memberCount + 1)
      );

      allow delete: if false;
    }

    // leagues/{leagueId}/members/{userId} — dichiarata con il path
    // ricorsivo `{path=**}` (non annidata dentro `leagues`) perché
    // `watchMyLeagues` usa una collection GROUP query su `members` per
    // trovare le leghe di un utente: le regole annidate sotto un match
    // specifico non si applicano alle query di tipo collection group,
    // solo a letture/query già ancorate a un leagueId noto.
    match /{path=**}/members/{userId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.totalPoints == 0;

      // I punti restano di competenza server-side (Cloud Function,
      // Phase 9): dal client si aggiorna solo il profilo denormalizzato.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username', 'photoUrl']);

      allow delete: if false;
    }

    // Tutto il resto arriva nelle fasi successive insieme alla feature
    // corrispondente: fino ad allora resta negato di default, il che è
    // più sicuro di una regola aperta lasciata "per ora".
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
